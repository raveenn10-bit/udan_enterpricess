rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Direct owner email verification (Immediate, zero circular dependency on Firestore documents)
    function isOwner() {
      return isAuthenticated() && (
        request.auth.token.email == 'pibida17udan4131@gmail.com' ||
        (exists(/databases/$(database)/documents/admin_profiles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admin_profiles/$(request.auth.uid)).data.role == 'owner')
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        isOwner() ||
        (exists(/databases/$(database)/documents/admin_profiles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admin_profiles/$(request.auth.uid)).data.role == 'staff')
      );
    }

    // 1. PUBLIC PRODUCTS COLLECTION
    match /products/{productId} {
      // Anyone can view products in catalogue
      allow read: if true;
      // Staff and Owner can manage products
      allow create, update, delete: if isStaff() || isOwner();
    }

    // 2. OFFERS & PROMOTIONS
    match /offers/{offerId} {
      allow read: if true;
      allow create, update, delete: if isStaff() || isOwner();
    }

    // 3. TEST RIDE BOOKINGS (Public write, Staff/Owner manage)
    match /test_ride_bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isStaff() || isOwner();
    }

    // 4. CONTACT INQUIRIES (Public write, Staff/Owner manage)
    match /contact_inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isStaff() || isOwner();
    }

    // 5. SERVICE BOOKINGS & NEWSLETTER
    match /service_bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isStaff() || isOwner();
    }

    match /newsletter_subscribers/{subscriberId} {
      allow create: if true;
      allow read, delete: if isStaff() || isOwner();
    }

    // 6. SHOWROOM SETTINGS & MINI CMS
    match /settings/{docId} {
      allow read: if true;
      allow write: if isStaff() || isOwner();
    }

    match /site_content/{docId} {
      allow read: if true;
      allow write: if isStaff() || isOwner();
    }

    // 7. ADMIN PROFILES
    match /admin_profiles/{uid} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == uid || isOwner());
    }

    // 8. AUDIT LOGS (Append-only)
    match /audit_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isStaff() || isOwner();
      allow update, delete: if false;
    }
  }
}
